rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    // users/{email} is keyed by the account's lowercased email.
    function myId() {
      return request.auth.token.email.lower();
    }
    // Role lives in Firestore (users/{email}), not a Firebase Auth custom claim — custom claims
    // need the Admin SDK (a Cloud Function), which this app deliberately has none of. The first
    // admin was seeded directly against the API, bypassing these rules, since nothing here can
    // grant the very first admin (that would be a backdoor baked into the rules themselves).
    // An account may hold several roles (users/{email}.roles); the older single `role` field
    // still counts so nothing breaks for records written before roles became a list.
    function hasRole(data, r) {
      return data.role == r || ('roles' in data && r in data.roles);
    }
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(myId())) &&
        hasRole(get(/databases/$(database)/documents/users/$(myId())).data, 'admin');
    }
    // Any role (scheduler, pm, coordinator, admin) may edit; an account with none is view-only.
    function canEdit() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(myId())) &&
        (get(/databases/$(database)/documents/users/$(myId())).data.role in ['scheduler', 'pm', 'coordinator', 'admin'] ||
          ('roles' in get(/databases/$(database)/documents/users/$(myId())).data &&
            get(/databases/$(database)/documents/users/$(myId())).data.roles.size() > 0));
    }

    // Activity log (engine/audit.js): anyone signed in may read it and add entries as themselves;
    // nothing in it can ever be changed or removed from a client.
    match /audit/{id} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.by == myId() &&
        request.resource.data.keys().hasAll(['by', 'at', 'area', 'action', 'lines', 'expiresAt']);
      allow update, delete: if false;
    }
    // True when the write being evaluated also creates audit/{id} (same batch) as the caller.
    function auditedBy(id) {
      return id is string &&
        !exists(/databases/$(database)/documents/audit/$(id)) &&
        existsAfter(/databases/$(database)/documents/audit/$(id)) &&
        getAfter(/databases/$(database)/documents/audit/$(id)).data.by == myId();
    }

    match /boards/{doc} {
      // The whole app lives in this one shared document — it must never be deletable from a
      // client, even an authenticated one. Deleting it is what silently wiped the real roster
      // and had the app auto-recreate itself from demo seed data with no warning to anyone.
      allow read: if signedIn();
      allow create: if signedIn();
      allow delete: if false;
      // Administration (roster, projects, overhead, staffing roles, holidays) is admin-only —
      // enforced here, not just hidden in the UI. Everything else (days/notes/demands/aiHistory —
      // day-to-day scheduling) stays open to any signed-in user.
      // Every change must come with its activity-log entry (boards/main.lastAuditId) — a board
      // write without one is refused, so nothing changes here without a record of who did it.
      allow update: if canEdit() &&
        auditedBy(request.resource.data.lastAuditId) &&
        (!request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['people', 'projects', 'overhead', 'staffingRoles', 'holidays'])
         || isAdmin());
    }

    // Manpower requests (engine/requests.js): one document each, so who may do what is decided
    // per request. Anyone signed in may ask; the requester may reply, withdraw, or acknowledge
    // the outcome; the coordinator of the branch asked (users/{email}.role == 'coordinator'
    // with that branch) or an admin may reply, approve, or decline.
    function myUser() {
      return get(/databases/$(database)/documents/users/$(myId())).data;
    }
    function coordinatesBranch(branch) {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(myId())) &&
        hasRole(myUser(), 'coordinator') && myUser().branch == branch;
    }
    match /requests/{id} {
      allow read: if signedIn();
      allow create: if canEdit() &&
        request.resource.data.fromEmail == myId() &&
        request.resource.data.status == 'open';
      allow update: if signedIn() && resource.data.fromEmail == myId() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['thread', 'updatedAt', 'requesterSeen', 'status']) &&
        (request.resource.data.status == resource.data.status ||
          (resource.data.status == 'open' && request.resource.data.status == 'cancelled'));
      allow update: if (isAdmin() || coordinatesBranch(resource.data.toBranch)) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['thread', 'updatedAt', 'status', 'resolvedBy', 'resolvedAt', 'requesterSeen']) &&
        (request.resource.data.status == resource.data.status ||
          (resource.data.status == 'open' && request.resource.data.status in ['approved', 'declined']));
      allow delete: if isAdmin();
    }

    match /users/{email} {
      allow read: if signedIn();
      // Admins manage every record: role, branch, add, remove.
      allow create, update, delete: if isAdmin();
      // Every account registers its own record on first sign-in (so the Users page lists everyone
      // who has ever logged in) and keeps its lastSeenAt current — but can never set its own
      // role(s) or branch. Those fields are admin-only.
      allow create: if signedIn() && email == myId() &&
        !request.resource.data.keys().hasAny(['role', 'roles', 'branch']);
      allow update: if signedIn() && email == myId() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'roles', 'branch']);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
